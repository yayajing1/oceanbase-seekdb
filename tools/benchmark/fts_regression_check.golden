# === tokenizer output ===
tokenize() -> []
tokenize() -> []
tokenize(a) -> ["a"]
tokenize(a) -> []
tokenize(0) -> ["0"]
tokenize(0) -> []
tokenize(1,234.56) -> ["1,234.56"]
tokenize(1,234.56) -> ["234"]
tokenize(#hash) -> ["hash"]
tokenize(#hash) -> ["hash"]
tokenize(a-b_c@d) -> ["a-b_c@d"]
tokenize(a-b_c@d) -> []
tokenize(全文索引) -> ["全文索引"]
tokenize(全文索引) -> ["全文索引"]
tokenize(分词器) -> ["分词器"]
tokenize(分词器) -> ["分词器"]
tokenize(OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用) -> ["是", "解析器", "非常", "数据库", "复用", "的", "优化", "oceanbase", "一款", "分词器", "全文索引", "包括", "路径", "稳定", "热", "实例"]
tokenize(OceanBase是一款非常稳定的数据库，全文索引的分词器热路径优化包括解析器实例复用) -> []
tokenize(一) -> ["一"]
tokenize(一) -> ["一"]
tokenize(一二三) -> ["一二三"]
tokenize(一二三) -> ["一二三"]
tokenize(十) -> ["十"]
tokenize(十) -> ["十"]
tokenize(百万) -> ["百万"]
tokenize(百万) -> ["百万"]
tokenize(2024年) -> ["2024年"]
tokenize(2024年) -> ["2024年"]
tokenize(第3章) -> ["第", "3章"]
tokenize(第3章) -> ["第3章"]
tokenize(第3章第三节) -> ["第三节", "第", "3章"]
tokenize(第3章第三节) -> ["第3章第三节"]
tokenize(混合ABC123中文) -> ["abc123", "中文", "混合"]
tokenize(混合ABC123中文) -> ["混合abc123中文"]
tokenize(数据库database数据库) -> ["database", "数据库"]
tokenize(数据库database数据库) -> ["数据库database数据库"]
tokenize(ＡＢＣ全角) -> ["全角", "ａｂｃ"]
tokenize(ＡＢＣ全角) -> ["ａｂｃ全角"]
tokenize(😀表情符号) -> ["表情符号"]
tokenize(😀表情符号) -> ["😀表情符号"]
tokenize(emoji😀测试) -> ["测试", "emoji"]
tokenize(emoji😀测试) -> ["emoji😀测试"]
tokenize(  多个   空格  ) -> ["多个", "空格"]
tokenize(  多个   空格  ) -> ["多个", "空格"]
tokenize(换行\n换行) -> ["换行"]
tokenize(换行\n换行) -> ["换行"]
tokenize(tab\t分隔) -> ["分隔", "tab"]
tokenize(tab\t分隔) -> ["分隔", "tab"]
tokenize(Ωμέγα) -> []
tokenize(Ωμέγα) -> ["ωμέγα"]
tokenize(12345678901234567890) -> ["12345678901234567890"]
tokenize(12345678901234567890) -> ["12345678901234567890"]
tokenize(a1b2c3) -> ["a1b2c3"]
tokenize(a1b2c3) -> ["a1b2c3"]
tokenize(中文分词器分词器中文分词器) -> ["分词器", "中文"]
tokenize(中文分词器分词器中文分词器) -> ["中文分词器分词器中文分词器"]
tokenize(１，２３４) -> ["１", "２３４"]
tokenize(１，２３４) -> ["１，２３４"]
tokenize(a－b) -> ["a", "b"]
tokenize(a－b) -> ["a－b"]
tokenize(＃标签) -> ["标签"]
tokenize(＃标签) -> ["＃标签"]
tokenize(全文索引，数据库。) -> ["全文索引", "数据库"]
tokenize(全文索引，数据库。) -> ["全文索引，数据库。"]
tokenize(１２３．４５６) -> ["４５６", "１２３"]
tokenize(１２３．４５６) -> ["１２３．４５６"]
tokenize(ＡＢＣ－ＤＥＦ) -> ["ｄｅｆ", "ａｂｃ"]
tokenize(ＡＢＣ－ＤＥＦ) -> ["ａｂｃ－ｄｅｆ"]
